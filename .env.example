# Copy this file to .env and fill in what you have.
# Never commit .env. Do not put live Stripe keys here.

PORT=3000
SESSION_SECRET=change-this-session-secret

# Still-room desk login. Used only when the database is first created.
ADMIN_USER=admin
ADMIN_PASSWORD=stillroom-dev

# Stripe test mode. Leave blank to run the shop without payments.
# Checkout then explains that test keys are required, and the cart still works.
# Secret keys start with sk_test_ and publishable keys start with pk_test_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional. Defaults to the request host, which is right for local use.
# PUBLIC_URL=http://localhost:3000
