<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <section class="page-hero plain">
    <div class="still-wrap">
      <h1>Basket</h1>
      <% if (!cart.items.length) { %>
        <p>Your basket is empty—discover something lovely.</p>
      <% } %>
    </div>
  </section>
  <section class="section" style="padding-top:1.5rem;">
    <div class="still-wrap">
      <% if (!cart.items.length) { %>
        <p style="margin-top:1rem;"><a class="btn-still" href="/shop" target="_blank" rel="noopener">All Products</a></p>
      <% } else { %>
        <table class="basket-table">
          <thead>
            <tr><th>Piece</th><th>Price</th><th>Qty</th><th></th></tr>
          </thead>
          <tbody>
            <% cart.items.forEach(function (item) { %>
              <tr>
                <td>
                  <a href="/product/<%= item.product.slug %>" target="_blank" rel="noopener"><strong><%= shopName(item.product.name) %></strong></a>
                  <div class="muted"><%= item.product.size %></div>
                  <%- include('partials/stock-label', { product: item.product }) %>
                </td>
                <td><%= nzd(item.lineTotal) %></td>
                <td>
                  <form method="post" action="/cart/update">
                    <input type="hidden" name="id" value="<%= item.product.id %>">
                    <input name="qty" type="number" min="0" max="<%= Number(item.product.launched) ? (Number(item.product.stock) || 0) : 0 %>" value="<%= item.qty %>" style="width:70px;">
                    <button class="btn-line" type="submit" style="margin-top:.4rem;">Update</button>
                  </form>
                </td>
                <td>
                  <form method="post" action="/cart/remove">
                    <input type="hidden" name="id" value="<%= item.product.id %>">
                    <button class="btn-line" type="submit">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="basket-summary">
          <p class="eyebrow">Subtotal</p>
          <p class="buy-price"><%= nzd(cart.subtotal) %></p>
          <p class="fine">New Zealand dollars. Click and collect from the lockbox in Rangiora.</p>
          <p class="fine delivery-quiet"><%= copy.lockbox_note %></p>
          <% if (stockProblems && stockProblems.length) { %>
            <div class="notice"><strong>Stock has changed.</strong> <%= stockProblems.join(' ') %> Update the basket before checkout.</div>
          <% } %>
          <p style="margin-top:1rem;"><a class="btn-still" href="/checkout" target="_blank" rel="noopener">Checkout</a></p>
          <%- include('partials/policy-links') %>
        </div>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
