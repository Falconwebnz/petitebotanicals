  <section class="section">
    <div class="still-wrap" style="max-width:680px;">
      <p class="eyebrow">Checkout</p>
      <h1 class="serif" style="font-size:clamp(2.8rem,6vw,4.4rem);line-height:.95;">Nothing was taken.</h1>
