<% var cardImage = liveImage(product.image); %>
<article class="batch-card">
  <a class="batch-visual" href="/product/<%= product.slug %>" target="_blank" rel="noopener">
    <% if (cardImage) { %>
      <img src="<%= cardImage %>" alt="<%= shopName(product.name) %>" oncontextmenu="return false;">
    <% } else { %>
      <div class="plate">
        <span><%= product.category_name %></span>
        <strong><%= shopName(product.name) %></strong>
      </div>
    <% } %>
  </a>
  <div class="batch-body">
    <%- include('stock-label', { product: product }) %>
    <div class="batch-cat"><%= product.category_name %></div>
    <h3><a href="/product/<%= product.slug %>" target="_blank" rel="noopener"><%= shopName(product.name) %></a></h3>
    <p class="price"><%= nzd(product.price_cents) %><% if (product.size) { %><span class="price-size"> · <%= product.size %></span><% } %></p>
    <% if (product.short_description) { %><p class="batch-blurb"><%= product.short_description %></p><% } %>
  </div>
</article>
