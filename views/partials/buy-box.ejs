<div class="buy-col">
  <p class="eyebrow"><%= product.category_name %></p>
  <h1><%= shopName(product.name) %></h1>
  <% if (product.notes) { %><div class="buy-notes"><%- include('text-blocks', { blocks: textBlocks(product.notes) }) %></div><% } %>
  <p class="buy-price"><%= nzd(product.price_cents) %></p>
  <p class="muted"><%= product.size || 'Size to be set' %></p>
  <%- include('stock-label', { product: product }) %>
  <% if (Number(product.launched) && (Number(product.stock) || 0) > 0) { %>
    <form method="post" action="/cart/add">
      <input type="hidden" name="id" value="<%= product.id %>">
      <div class="qty-row">
        <label for="qty-<%= product.id %>" class="mb-0">Quantity</label>
        <input id="qty-<%= product.id %>" name="qty" type="number" min="1" max="<%= product.stock %>" value="1">
      </div>
      <button class="btn-still" type="submit">Add to basket</button>
    </form>
  <% } %>
</div>
