<div class="topbar">Small batches · Made in Canterbury, New Zealand · No synthetic fragrance</div>
<header class="site-header">
  <div class="still-wrap header-row">
    <button class="menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#stillMenu" aria-label="Open menu">
      <svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true"><path d="M0 1h22M0 8h22M0 15h22" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
    <a class="brand" href="/" target="_blank" rel="noopener">
      <span class="logo-clip"><img src="/images/brand/logo.png" alt="Petite Botanicals"></span>
      <span>
        <span class="brand-name">Petite Botanicals</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Main">
      <div class="nav-drop">
        <a class="nav-drop-link <%= (path === '/shop' || path.indexOf('/category/') === 0) ? 'active' : '' %>" href="/shop" target="_blank" rel="noopener" aria-haspopup="true" aria-expanded="false" aria-controls="shop-menu">Shop</a>
        <div class="nav-drop-panel nav-mega" id="shop-menu">
          <div class="mega-links">
            <% categories.forEach(function (cat) { %>
              <a class="<%= path.indexOf('/category/' + cat.slug) === 0 ? 'active' : '' %>" href="/category/<%= cat.slug %>" target="_blank" rel="noopener"><%= cat.slug === 'botanical-perfumes' ? cat.name.replace('Botanical ', '') : cat.name %><% if (isComingSoon(cat)) { %> <span class="soon-tag">Coming soon</span><% } %></a>
            <% }) %>
            <a href="/shop" target="_blank" rel="noopener">All products</a>
          </div>
          <div class="mega-images">
            <% categories.forEach(function (cat) { %>
              <a class="mega-card" href="/category/<%= cat.slug %>" target="_blank" rel="noopener">
                <img src="<%= menuImageFor(cat, settings) %>" alt="<%= cat.name %>" oncontextmenu="return false;">
                <span><%= cat.slug === 'botanical-perfumes' ? cat.name.replace('Botanical ', '') : cat.name %><% if (isComingSoon(cat)) { %> · Coming soon<% } %></span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
      <a class="<%= path === '/about' ? 'active' : '' %>" href="/about" target="_blank" rel="noopener">Our Story</a>
      <a href="/#loved" target="_blank" rel="noopener">Testimonials</a>
      <a class="<%= path === '/standards' ? 'active' : '' %>" href="/standards" target="_blank" rel="noopener">Our Standards</a>
      <a class="<%= path === '/pickup' ? 'active' : '' %>" href="/pickup" target="_blank" rel="noopener">Click &amp; Collect</a>
      <a class="<%= path === '/contact' ? 'active' : '' %>" href="/contact" target="_blank" rel="noopener">Contact us</a>
      <a class="<%= path === '/cart' ? 'active' : '' %>" href="/cart" target="_blank" rel="noopener">Basket</a>
    </nav>
    <div class="header-tools">
      <form class="search-form" action="/search" method="get">
        <label class="visually-hidden" for="q">Search</label>
        <input id="q" name="q" type="search" placeholder="Products and ingredients" value="<%= typeof q !== 'undefined' ? q : '' %>">
      </form>
      <a class="icon-btn basket-link" href="/cart" target="_blank" rel="noopener" aria-label="Basket">
        <span class="basket-word">Basket</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 7h15l-1.4 8.2a2 2 0 0 1-2 1.6H9.2a2 2 0 0 1-2-1.6L5.2 4H3" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="20" r="1.2" fill="currentColor"/><circle cx="17" cy="20" r="1.2" fill="currentColor"/></svg>
        <% if (cartCount) { %><span class="basket-count"><%= cartCount %></span><% } %>
      </a>
    </div>
  </div>
</header>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<div class="offcanvas offcanvas-start" tabindex="-1" id="stillMenu" aria-labelledby="stillMenuLabel">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title serif" id="stillMenuLabel">Petite Botanicals</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <form action="/search" method="get" class="mb-3">
      <input name="q" type="search" placeholder="Products and ingredients" aria-label="Search" value="<%= typeof q !== 'undefined' ? q : '' %>">
    </form>
    <a href="/cart" target="_blank" rel="noopener">Basket<% if (cartCount) { %> (<%= cartCount %>)<% } %></a>
    <% categories.forEach(function (cat) { %>
      <a href="/category/<%= cat.slug %>" target="_blank" rel="noopener"><%= cat.name %><% if (isComingSoon(cat)) { %> <span class="soon-tag">Coming soon</span><% } %></a>
    <% }) %>
    <a href="/shop" target="_blank" rel="noopener">All small batches</a>
    <a href="/about" target="_blank" rel="noopener">Our story</a>
    <a href="/#loved" target="_blank" rel="noopener">Testimonials</a>
    <a href="/standards" target="_blank" rel="noopener">Our Standards</a>
    <a href="/pickup" target="_blank" rel="noopener">Click &amp; Collect</a>
    <a href="/contact" target="_blank" rel="noopener">Contact us</a>
  </div>
</div>
