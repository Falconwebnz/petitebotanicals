<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <section class="section">
    <div class="still-wrap" style="max-width:680px;">
      <% if (paid) { %>
        <p class="eyebrow">Canterbury</p>
        <h1 class="serif" style="font-size:clamp(2.8rem,6vw,4.4rem);line-height:.95;">Thank you for your order!</h1>
        <p>Your order is being made. The padlock code is the last four digits of the mobile number you gave us. We text you when it is in the lockbox, and where to collect it.</p>
      <% } else { %>
        <p class="eyebrow">Checkout</p>
        <h1 class="serif" style="font-size:clamp(2.8rem,6vw,4.4rem);line-height:.95;">Your order is with us.</h1>
        <p>This page is where a finished checkout returns. If you opened it directly, no payment has been taken and the basket is unchanged.</p>
      <% } %>
      <p><a class="btn-still" href="/shop" target="_blank" rel="noopener">Back to the shop</a></p>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
