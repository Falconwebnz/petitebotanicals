<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <section class="page-banner">
    <img class="page-banner-photo page-banner-photo--dropper" src="/images/brand/hero-dropper.jpg" alt="Herbal oil dropper above a glass bottle" oncontextmenu="return false;">
    <div class="page-banner-scrim"></div>
    <div class="still-wrap page-banner-copy">
      <p class="eyebrow">How we work</p>
      <h1>Our Standards</h1>
    </div>
  </section>
  <section class="section" style="padding-top:2rem;">
    <div class="still-wrap about-layout">
      <div class="story-mark">
        <div class="logo-clip"><img src="/images/brand/logo.png" alt="Petite Botanicals logo"></div>
        <p>Canterbury, New Zealand</p>
        <p class="muted"><%= settings.standards_aside || '' %></p>
        <div class="story-photo-frame">
          <img class="story-photo--peak" src="/images/brand/story-peak.jpg" alt="A snow-covered mountain above a stony river" oncontextmenu="return false;">
        </div>
      </div>
      <article>
        <% if (settings.standards_intro) { %><p><%= settings.standards_intro %></p><% } %>
        <ul>
          <% ['standards_point_1', 'standards_point_2', 'standards_point_3'].forEach(function (name) { %>
            <% if (settings[name]) { %><li><%= settings[name] %></li><% } %>
          <% }) %>
        </ul>
        <%- include('partials/standard-marks', { showImages: false }) %>
        <% if (settings.standards_heading) { %><h2><%= settings.standards_heading %></h2><% } %>
        <%- include('partials/prose-blocks', { blocks: contentBlocks(settings.standards_body) }) %>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
