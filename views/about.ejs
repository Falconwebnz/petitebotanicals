<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <section class="page-banner">
    <img class="page-banner-photo page-banner-photo--story" src="/images/brand/story-coast.jpg" alt="A stony Canterbury beach beside a pale cliff and the sea" oncontextmenu="return false;">
    <div class="page-banner-scrim"></div>
    <div class="still-wrap page-banner-copy">
      <% if (settings.story_eyebrow) { %><p class="eyebrow"><%= settings.story_eyebrow %></p><% } %>
      <h1><%= settings.story_headline || 'Our Story' %></h1>
    </div>
    <p class="place-ref">Gore Bay, North Canterbury</p>
  </section>
  <section class="section" style="padding-top:2rem;">
    <div class="still-wrap about-layout">
      <div class="story-mark">
        <div class="logo-clip"><img src="/images/brand/logo.png" alt="Petite Botanicals logo"></div>
        <% if (settings.story_place) { %><p><%= settings.story_place %></p><% } %>
        <% if (settings.story_aside) { %><p class="muted"><%= settings.story_aside %></p><% } %>
        <div class="story-photo-frame">
          <img src="/images/brand/story-falls.jpg" alt="A fern-lined waterfall in a New Zealand forest" oncontextmenu="return false;">
        </div>
      </div>
      <article>
        <%- include('partials/prose-blocks', { blocks: blocks, marks: true }) %>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
