<%- include('partials/head') %>
<script type="application/ld+json"><%- jsonLd({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: shopName(product.name),
  description: [product.short_description, product.ingredients].filter(Boolean).join(' '),
  category: product.category_name,
  brand: { '@type': 'Brand', name: 'Petite Botanicals' },
  url: origin + '/product/' + product.slug,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'NZD',
    price: (product.price_cents / 100).toFixed(2),
    availability: product.in_stock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    url: origin + '/product/' + product.slug
  }
}) %></script>
<%- include('partials/header') %>
<main>
  <div class="still-wrap product-layout">
    <div>
      <div class="figure-frame">
        <% if (liveImage(product.image)) { %>
          <img src="<%= liveImage(product.image) %>" alt="<%= shopName(product.name) %>" oncontextmenu="return false;">
        <% } else { %>
          <div class="plate">
            <span><%= product.category_name %></span>
            <strong><%= shopName(product.name) %></strong>
          </div>
        <% } %>
      </div>
      <div class="mobile-buy" style="margin-top:1rem;">
        <%- include('partials/buy-box', { product: product }) %>
      </div>
      <% if (product.long_description) { %>
        <div class="card-block">
          <h2>The scent</h2>
          <div class="prose-text"><%- include('partials/text-blocks', { blocks: textBlocks(product.long_description) }) %></div>
        </div>
      <% } %>
      <% if (product.ingredients) { %>
        <div class="card-block">
          <h2>Ingredients</h2>
          <div class="prose-text"><%- include('partials/text-blocks', { blocks: textBlocks(product.ingredients) }) %></div>
          <p class="fine"><a href="/glossary" target="_blank" rel="noopener">Read the glossary</a>.</p>
        </div>
      <% } %>
      <% if (product.how_to_use) { %>
        <div class="card-block">
          <h2>How to use</h2>
          <div class="prose-text"><%- include('partials/text-blocks', { blocks: textBlocks(product.how_to_use) }) %></div>
        </div>
      <% } %>
      <% if (product.precautions) { %>
        <div class="card-block">
          <h2>Precautions</h2>
          <div class="prose-text"><%- include('partials/text-blocks', { blocks: textBlocks(product.precautions) }) %></div>
        </div>
      <% } %>
      <% if (faqs && faqs.length) { %>
        <div class="card-block faq-band faq-band-product">
          <h2 id="product-faqs">FAQs about this product</h2>
          <%- include('partials/faq-list', { faqs: faqs, faqName: 'product-' + product.id }) %>
          <%- include('partials/faq-links', { links: [
            { href: '/category/' + product.category_slug, label: 'FAQs about this collection', icon: 'collection' },
            { href: '/faq', label: 'View all FAQs', icon: 'question' }
          ] }) %>
        </div>
      <% } %>
      <% if (related.length) { %>
        <div class="card-block">
          <h2>Also on the bench</h2>
          <div class="product-grid" style="margin-top:1rem;">
            <% related.forEach(function (product) { %>
              <%- include('partials/product-card', { product: product }) %>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
    <div class="desktop-buy">
      <%- include('partials/buy-box', { product: product }) %>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
