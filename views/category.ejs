<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <% var heroImage = liveImage(category.hero_image); %>
  <% if (category.slug === 'balms' || category.slug === 'mist-sprays') { %>
  <section class="page-banner">
    <% if (category.slug === 'balms') { %>
    <img class="page-banner-photo page-banner-photo--balms" src="/images/brand/balms-banner.jpg" alt="Gloved hands filling a jar with cream" oncontextmenu="return false;">
    <% } else { %>
    <img class="page-banner-photo page-banner-photo--mist" src="/images/brand/mist-banner.jpg" alt="A woman among green leaves" oncontextmenu="return false;">
    <% } %>
    <div class="page-banner-scrim"></div>
    <div class="still-wrap page-banner-copy">
      <h1><%= category.name %></h1>
    </div>
  </section>
  <% } else { %>
  <section class="page-hero <%= heroImage ? '' : 'plain' %>" <% if (heroImage) { %>style="--hero:url('<%= heroImage %>')"<% } %>>
    <div class="still-wrap">
      <h1><%= category.name %></h1>
    </div>
  </section>
  <% } %>
  <% if (comingSoon) { %>
  <section class="section coming-soon" aria-labelledby="coming-soon-heading">
    <div class="still-wrap coming-soon-card">
      <h2 id="coming-soon-heading">Coming Soon</h2>
      <p>This collection is being finished in small batches. In the meantime, have a look at what’s ready now.</p>
      <div class="text-tabs"><a class="text-tab" href="/shop" target="_blank" rel="noopener">Shop the collection</a></div>
    </div>
  </section>
  <% } else { %>
  <section class="section category-products">
    <div class="still-wrap">
      <% if (!products.length) { %>
        <div class="empty">This category is empty.</div>
      <% } else { %>
        <div class="product-grid">
          <% products.forEach(function (product) { %>
            <%- include('partials/product-card', { product: product }) %>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
  <% if (category.about_title || aboutBlocks.length) { %>
  <section class="category-about" aria-labelledby="about-heading">
    <div class="still-wrap">
      <% if (category.about_title) { %><h2 id="about-heading"><%= category.about_title %></h2><% } %>
      <%- include('partials/text-blocks', { blocks: aboutBlocks }) %>
    </div>
  </section>
  <% } %>
  <section class="faq-band" aria-labelledby="faq-heading">
    <div class="still-wrap">
      <h2 id="faq-heading"><%= faqHeading %></h2>
      <% if (!faqs.length) { %>
        <p class="faq-empty">FAQs for this collection will appear here.</p>
      <% } else { %>
        <%- include('partials/faq-list', { faqs: faqs, faqName: 'cat-' + category.id }) %>
        <%- include('partials/faq-links', { links: [
          { href: '/glossary', label: 'More about our ingredients', icon: 'leaf' },
          { href: '/standards', label: 'Our standards', icon: 'seal' },
          { href: '/faq', label: 'View all FAQs', icon: 'question' }
        ] }) %>
      <% } %>
    </div>
  </section>
  <% } %>
</main>
<%- include('partials/footer') %>
