<%- include('partials/head') %>
<script type="application/ld+json"><%- jsonLd({
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Petite Botanicals ingredient glossary',
  url: origin + '/glossary',
  hasDefinedTerm: entries.map(function (entry) {
    return {
      '@type': 'DefinedTerm',
      name: entry.term,
      alternateName: entry.inci || undefined,
      description: entry.body || undefined,
      url: origin + '/glossary#' + entry.id
    };
  })
}) %></script>
<%- include('partials/header') %>
<main>
  <section class="page-hero plain">
    <div class="still-wrap">
      <p class="eyebrow">Ingredients</p>
      <h1>Glossary</h1>
    </div>
  </section>
  <section class="section policy-section">
    <div class="still-wrap glossary-wrap">
      <% String(settings.glossary_intro || '').split(/\n{2,}/).forEach(function (para) { %>
        <% if (para.trim()) { %><p class="policy-lead"><%= para.trim() %></p><% } %>
      <% }) %>
      <% if (groups.length) { %>
        <nav class="alpha-nav" aria-label="Glossary letters">
          <% groups.forEach(function (group) { %>
            <a href="#<%= group.id %>"><%= group.letter %></a>
          <% }) %>
        </nav>
        <% groups.forEach(function (group) { %>
          <section class="glossary-group" id="<%= group.id %>" aria-labelledby="label-<%= group.id %>">
            <h2 id="label-<%= group.id %>"><%= group.letter %></h2>
            <% group.entries.forEach(function (entry) { %>
              <article class="glossary-entry" id="<%= entry.id %>">
                <h3><%= entry.term %></h3>
                <% if (entry.inci) { %><p class="inci">INCI · <%= entry.inci %></p><% } %>
                <% if (entry.body) { %><p><%= entry.body %></p><% } %>
              </article>
            <% }) %>
          </section>
        <% }) %>
      <% } else { %>
        <p class="empty">The glossary is being written.</p>
      <% } %>
      <% String(settings.glossary_note || '').split(/\n{2,}/).forEach(function (para) { %>
        <% if (para.trim()) { %><p class="glossary-note"><%= para.trim() %></p><% } %>
      <% }) %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
