<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <section class="hero" aria-label="Petite Botanicals">
    <img class="hero-photo hero-photo--meadow" src="<%= settings.hero_image || '/images/brand/meadow.jpg' %>" alt="Red-haired woman in a white-flower meadow" fetchpriority="high" oncontextmenu="return false;">
    <div class="hero-scrim"></div>
    <div class="still-wrap hero-inner">
      <p class="eyebrow"><%= settings.hero_kicker %></p>
      <h1><%= settings.hero_headline %></h1>
      <hr class="gold-rule">
      <div class="hero-actions">
        <a class="btn-shop" href="/shop" target="_blank" rel="noopener">Discover our collection</a>
      </div>
    </div>
  </section>

  <section class="section collection-intro">
    <div class="still-wrap">
      <div class="section-head">
        <p class="eyebrow">The collection</p>
        <h2>Botanical scent. Everyday care.</h2>
        <p>Explore botanical perfumes, nourishing balms, magnesium body mist and room mists — a considered collection for skin, body and home.</p>
      </div>
    </div>
  </section>

  <div class="collection-wrap">
    <div class="drawers">
      <% cats.forEach(function (cat, i) { %>
        <a class="drawer drawer-<%= i + 1 %><%= cat.video ? ' drawer-motion' : '' %>" href="/category/<%= cat.slug %>" target="_blank" rel="noopener">
          <% if (cat.video) { %>
            <video class="drawer-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
              <source src="<%= cat.video %>" type="<%= cat.videoType %>">
            </video>
            <span class="drawer-scrim" aria-hidden="true"></span>
          <% } %>
          <span class="drawer-copy">
            <h3><%= cat.slug === 'mist-sprays' ? 'Magnesium Body Mists' : cat.name %></h3>
            <% if (cat.line) { %><p><%= cat.line %></p><% } %>
          </span>
        </a>
      <% }) %>
    </div>
  </div>

  <section class="section">
    <div class="still-wrap">
      <div class="section-head">
        <p class="eyebrow">Featured</p>
        <h2>From the collection.</h2>
      </div>
      <div class="rail-wrap">
        <div class="batch-rail">
          <% featured.forEach(function (product) { %>
            <div><%- include('partials/product-card', { product: product }) %></div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <section class="quiet quiet-coast">
    <img class="quiet-photo" src="/images/brand/home-coast.jpg" alt="" oncontextmenu="return false;">
    <div class="quiet-scrim" aria-hidden="true"></div>
    <div class="section quiet-copy">
      <div class="still-wrap">
        <div class="house-grid">
          <article>
            <p class="eyebrow">Ingredients</p>
            <h2>Sourcing the highest quality</h2>
            <p>Botanical perfumes and body care, made without synthetic fragrance. Essential oils and simple bases, so you can read what is in each product.</p>
            <div class="text-tabs"><a class="text-tab" href="/glossary" target="_blank" rel="noopener">Read the glossary</a></div>
          </article>
          <article>
            <p class="eyebrow">Sourcing</p>
            <h2>Made in Canterbury.</h2>
            <p>Small batches, made in Canterbury, New Zealand. Perfume oils use organic essential oils in organic jojoba, with documented botanicals throughout the range.</p>
            <div class="text-tabs"><a class="text-tab" href="/standards" target="_blank" rel="noopener">Our Standards</a></div>
          </article>
        </div>
      </div>
    </div>
    <p class="place-ref">Gore Bay, North Canterbury</p>
  </section>
</main>
<%- include('partials/footer') %>
