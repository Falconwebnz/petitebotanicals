<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <section class="hero" aria-label="Petite Botanicals">
    <img class="hero-photo hero-photo--meadow" src="<%= liveImage(settings.hero_image) || '/images/brand/meadow.jpg' %>" alt="Red-haired woman in a white-flower meadow" fetchpriority="high" oncontextmenu="return false;">
    <div class="hero-scrim"></div>
    <div class="still-wrap hero-inner">
      <p class="eyebrow"><%= settings.hero_kicker %></p>
      <h1><%= settings.hero_headline %></h1>
      <hr class="gold-rule">
      <div class="hero-actions">
        <a class="btn-shop" href="/shop" target="_blank" rel="noopener">Discover our collection</a>
      </div>
    </div>
  </section>

  <section class="section collection-intro">
    <div class="still-wrap">
      <div class="section-head">
        <p class="eyebrow">The collection</p>
        <h2>Botanical scent. Everyday care.</h2>
        <p>Explore botanical perfumes, nourishing balms, magnesium body mists and room mists — a considered collection for skin, body and home.</p>
      </div>
    </div>
  </section>

  <div class="collection-wrap">
    <div class="drawers">
      <% cats.forEach(function (cat, i) { %>
        <a class="drawer drawer-<%= i + 1 %><%= cat.video ? ' drawer-motion' : '' %>" href="/category/<%= cat.slug %>" target="_blank" rel="noopener">
          <% if (cat.video) { %>
            <video class="drawer-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
              <source src="<%= cat.video %>" type="<%= cat.videoType %>">
            </video>
            <span class="drawer-scrim" aria-hidden="true"></span>
          <% } %>
          <span class="drawer-copy">
            <h3><%= cat.name %></h3>
            <% if (cat.line) { %><p><%= cat.line %></p><% } %>
          </span>
        </a>
      <% }) %>
    </div>
  </div>

  <section class="section">
    <div class="still-wrap">
      <div class="section-head">
        <p class="eyebrow">Featured</p>
        <h2>From the collection.</h2>
      </div>
      <div class="rail-wrap">
        <div class="batch-rail">
          <% featured.forEach(function (product) { %>
            <div><%- include('partials/product-card', { product: product }) %></div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <section class="section loved" id="loved" aria-labelledby="loved-heading">
    <div class="still-wrap loved-wrap">
      <div class="section-head">
        <p class="eyebrow">Kind words</p>
        <h2 id="loved-heading">Loved by Customers</h2>
      </div>
      <% if (testimonials.length) { %>
      <div class="loved-slider" data-slider role="region" aria-roledescription="carousel" aria-label="Customer testimonials">
        <div class="loved-track" data-slider-track tabindex="0">
          <% testimonials.forEach(function (t, i) { %>
            <figure class="loved-card" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> of <%= testimonials.length %>">
              <blockquote>
                <% String(t.quote).split(/\n\s*\n/).forEach(function (para) { %><% if (para.trim()) { %><p><%= para.trim() %></p><% } %><% }) %>
              </blockquote>
              <figcaption>
                <span class="loved-mark" aria-hidden="true"><%= String(t.name || '').trim().charAt(0) %></span>
                <span class="loved-who"><strong><%= t.name %></strong><% if (t.detail) { %><span><%= t.detail %></span><% } %></span>
              </figcaption>
            </figure>
          <% }) %>
        </div>
        <% if (testimonials.length > 1) { %>
          <div class="loved-controls">
            <button class="loved-arrow" type="button" data-slider-prev aria-label="Previous testimonial">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="loved-dots" data-slider-dots></div>
            <button class="loved-arrow" type="button" data-slider-next aria-label="Next testimonial">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        <% } %>
      </div>
      <% } else { %>
      <p class="loved-waiting">Notes from people who use the collection will be added here.</p>
      <div class="text-tabs loved-waiting-actions">
        <a class="text-tab" href="/contact">Write to us</a>
      </div>
      <% } %>
    </div>
  </section>

  <section class="quiet quiet-coast">
    <img class="quiet-photo" src="/images/brand/home-coast.jpg" alt="" oncontextmenu="return false;">
    <div class="quiet-scrim" aria-hidden="true"></div>
    <div class="section quiet-copy">
      <div class="still-wrap">
        <article class="house-note">
          <p class="eyebrow">Ingredients &amp; sourcing</p>
          <h2>Simple ingredients, made in Canterbury.</h2>
          <p>Everything is made in small batches in Canterbury, New Zealand, with no synthetic fragrance.</p>
          <p>We use essential oils, organic where we can, in simple bases, so you can read exactly what’s in each product.</p>
          <div class="text-tabs">
            <a class="text-tab" href="/glossary" target="_blank" rel="noopener">Read the glossary</a>
            <a class="text-tab" href="/standards" target="_blank" rel="noopener">Our Standards</a>
          </div>
        </article>
      </div>
    </div>
    <p class="place-ref">Gore Bay, North Canterbury</p>
  </section>
</main>
<%- include('partials/footer') %>
