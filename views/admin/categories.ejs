<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main>
  <%- include('../partials/desk-bar') %>
  <section class="section" style="padding-top:1.4rem;">
    <div class="still-wrap">
      <h1 class="serif" style="font-size:3rem;">Categories</h1>
      <p class="muted">The four categories stay fixed. You can rewrite the about title and text, and change the hero image. The about text sits below the products. FAQs are edited under <a href="/admin/faqs">FAQs</a>.</p>
      <% cats.forEach(function (cat) { %>
        <article class="form-card">
          <h2 class="serif" style="margin-top:0;"><%= cat.name %></h2>
          <form method="post" action="/admin/categories/<%= cat.id %>" enctype="multipart/form-data">
            <label for="about-title-<%= cat.id %>">About title</label>
            <input id="about-title-<%= cat.id %>" name="about_title" type="text" value="<%= cat.about_title || '' %>">
            <label for="intro-<%= cat.id %>">About</label>
            <textarea id="intro-<%= cat.id %>" name="intro"><%= cat.intro || '' %></textarea>
            <label for="hero-<%= cat.id %>">Hero image</label>
            <% if (cat.hero_image) { %><p class="muted">Current: <%= cat.hero_image %></p><% } %>
            <input id="hero-<%= cat.id %>" name="hero_image" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
            <p style="margin-top:1rem;"><button class="btn-still" type="submit">Save <%= cat.name %></button></p>
          </form>
          <p class="muted" style="margin-top:1rem;"><a href="/admin/faqs#cat-<%= cat.id %>">Edit <%= cat.faqs.length %> <%= cat.faqs.length === 1 ? 'question' : 'questions' %></a></p>
        </article>
      <% }) %>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
