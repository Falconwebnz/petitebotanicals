<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main>
  <%- include('../partials/desk-bar') %>
  <section class="section" style="padding-top:1.4rem;">
    <div class="still-wrap" style="max-width:820px;">
      <h1 class="serif" style="font-size:3rem;">Homepage</h1>
      <form class="form-card" method="post" action="/admin/homepage" enctype="multipart/form-data">
        <label for="hero_kicker">Kicker</label>
        <input id="hero_kicker" name="hero_kicker" type="text" value="<%= settings.hero_kicker || '' %>">
        <label for="hero_headline">Headline</label>
        <input id="hero_headline" name="hero_headline" type="text" value="<%= settings.hero_headline || '' %>">
        <label for="hero_subhead">Subhead</label>
        <textarea id="hero_subhead" name="hero_subhead"><%= settings.hero_subhead || '' %></textarea>
        <label for="story_teaser">Story teaser</label>
        <textarea id="story_teaser" name="story_teaser" style="min-height:220px;"><%= settings.story_teaser || '' %></textarea>
        <label for="shop_intro">Shop intro</label>
        <textarea id="shop_intro" name="shop_intro"><%= settings.shop_intro || '' %></textarea>
        <p class="eyebrow" style="margin-top:1.4rem;">Arrival</p>
        <p class="muted">Nationwide delivery stays saved here for later. The shop is click and collect only, so customers do not see these shipping lines.</p>
        <label for="delivery_label">Nationwide delivery label</label>
        <input id="delivery_label" name="delivery_label" type="text" value="<%= settings.delivery_label || '' %>">
        <label for="shipping_prompt">Shipping info prompt</label>
        <textarea id="shipping_prompt" name="shipping_prompt"><%= settings.shipping_prompt || '' %></textarea>
        <label for="lockbox_note">Lock box sentence</label>
        <textarea id="lockbox_note" name="lockbox_note"><%= settings.lockbox_note || '' %></textarea>
        <label for="hero_image">Hero image</label>
        <% if (settings.hero_image && !liveImage(settings.hero_image)) { %><p class="starter-note">The saved hero image is missing from the server. Upload it again.</p><% } else if (settings.hero_image) { %><p class="muted">Current: <%= settings.hero_image %></p><% } %>
        <input id="hero_image" name="hero_image" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
        <p class="eyebrow" style="margin-top:1.4rem;">Shop menu images</p>
        <p class="muted">These pictures sit after the category names in the Shop menu. The samples below are used until you upload a replacement.</p>
        <% categories.forEach(function (cat) { %>
          <label for="menu-image-<%= cat.slug %>"><%= cat.name %></label>
          <p class="menu-sample"><img src="<%= menuImageFor(cat, settings) %>" alt=""></p>
          <input id="menu-image-<%= cat.slug %>" name="menu_image_<%= cat.slug %>" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
        <% }) %>
        <p style="margin-top:1rem;"><button class="btn-still" type="submit">Save homepage</button></p>
      </form>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
