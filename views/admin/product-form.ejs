<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main>
  <%- include('../partials/desk-bar') %>
  <section class="section" style="padding-top:1.4rem;">
    <div class="still-wrap" style="max-width:820px;">
      <h1 class="serif" style="font-size:3rem;"><%= product.id ? 'Edit ' + product.name : 'New product' %></h1>
      <form class="form-card" method="post" action="<%= action %>" enctype="multipart/form-data">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required value="<%= product.name %>">
        <label for="category_id">Category</label>
        <select id="category_id" name="category_id">
          <% categories.forEach(function (cat) { %>
            <option value="<%= cat.id %>" <%= Number(product.category_id) === Number(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
          <% }) %>
        </select>
        <label for="price">Price (NZD)</label>
        <input id="price" name="price" type="text" inputmode="decimal" value="<%= (product.price_cents / 100).toFixed(2) %>">
        <label for="size">Size</label>
        <input id="size" name="size" type="text" value="<%= product.size || '' %>">
        <label for="short_description">Short description</label>
        <textarea id="short_description" name="short_description"><%= product.short_description || '' %></textarea>
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes"><%= product.notes || '' %></textarea>
        <label for="long_description">Story / long notes</label>
        <textarea id="long_description" name="long_description" style="min-height:180px;"><%= product.long_description || '' %></textarea>
        <label for="ingredients">Ingredients</label>
        <textarea id="ingredients" name="ingredients"><%= product.ingredients || '' %></textarea>
        <label for="how_to_use">How to use</label>
        <textarea id="how_to_use" name="how_to_use"><%= product.how_to_use || '' %></textarea>
        <label for="precautions">Precautions</label>
        <textarea id="precautions" name="precautions"><%= product.precautions || '' %></textarea>
        <label for="image">Image</label>
        <% if (product.image) { %><p><img src="<%= product.image %>" alt="" style="max-height:140px;"></p><% } %>
        <input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
        <label for="stock">Stock on hand</label>
        <input id="stock" name="stock" type="number" min="0" step="1" required value="<%= Number(product.stock) || 0 %>" style="max-width:8rem;">
        <% if (product.launched) { %>
          <p class="muted">Live on the shop. Above 0 shows In-Stock. Less than 1 shows OUT OF STOCK.</p>
        <% } else { %>
          <p class="muted">Held in the desk until you launch it. It stays off the shop until then.</p>
        <% } %>
        <label class="check"><input type="checkbox" name="featured" <%= product.featured ? 'checked' : '' %>> Featured on the homepage</label>
        <label class="check"><input type="checkbox" name="is_starter" <%= product.is_starter ? 'checked' : '' %>> Starter card (show the replace-before-selling note)</label>
        <p style="margin-top:1.2rem;"><button class="btn-still" type="submit">Save</button></p>
      </form>
      <% if (product.id && !product.launched) { %>
        <form method="post" action="/admin/products/<%= product.id %>/launch">
          <button class="btn-still" type="submit">Launch on the shop</button>
          <p class="muted">Uses the stock on hand you last saved. Above 0 then shows In-Stock.</p>
        </form>
      <% } %>
      <% if (product.id && product.launched) { %>
        <form method="post" action="/admin/products/<%= product.id %>/unlaunch">
          <button class="btn-line" type="submit">Return to desk</button>
          <p class="muted">Takes this product off the shop and keeps the row, stock, and notes here so you can launch it again. This does not delete it.</p>
        </form>
      <% } %>
      <% if (product.id) { %>
        <p class="muted" id="questions"><a href="/admin/faqs#product-<%= product.id %>">Edit FAQs for this product</a></p>
      <% } %>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
