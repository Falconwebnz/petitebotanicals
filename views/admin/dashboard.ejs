<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main>
  <%- include('../partials/desk-bar') %>
  <section class="section" style="padding-top:2rem;">
    <div class="still-wrap">
      <h1 class="serif" style="font-size:3.2rem;">Good to see you.</h1>
      <div class="trust-grid" style="margin-top:1.5rem;">
        <article style="border-color:var(--line);"><h3><%= counts.products %></h3><p>Products on the bench</p></article>
        <article style="border-color:var(--line);"><h3><%= counts.featured %></h3><p>Featured on the homepage</p></article>
        <article style="border-color:var(--line);"><h3><%= counts.starters %></h3><p>Starter cards to replace</p></article>
        <article style="border-color:var(--line);"><h3><%= counts.readyToLaunch %></h3><p>Ready to launch</p></article>
        <article style="border-color:var(--line);"><h3><%= counts.outOfStock %></h3><p>Live and out of stock</p></article>
        <article style="border-color:var(--line);"><h3><%= counts.notes %></h3><p><a href="/admin/testimonials">Customer notes on the homepage</a></p></article>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
